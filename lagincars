<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Animated Truck Luggage Drop Auth Form</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts (Poppins) -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- GSAP CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    
    <!-- Canvas Confetti CDN -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="style.css">
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex items-center justify-center p-4 overflow-hidden relative font-['Poppins']">

    <!-- Canvas Background for Particle Dust -->
    <canvas id="dustCanvas" class="fixed inset-0 pointer-events-none z-0"></canvas>

    <!-- Road Surface Background -->
    <div class="fixed bottom-0 left-0 w-full h-36 road-container z-0">
        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-amber-500/40 to-transparent"></div>
        <div class="road-lines"></div>
    </div>

    <!-- Main Scene Stage (Centered Perfectly) -->
    <div class="relative z-10 w-full max-w-md min-h-[580px] flex items-center justify-center">

        <!-- TRUCK & SUITCASE ANIMATION LAYER -->
        <div id="sceneContainer" class="absolute inset-0 pointer-events-none z-20 flex items-center justify-center overflow-visible">
            
            <!-- Animated Delivery Truck SVG -->
            <div id="truckContainer" class="absolute left-[-600px] bottom-10 w-[420px] h-[180px] overflow-visible">
                <svg viewBox="0 0 500 220" class="w-full h-full drop-shadow-[0_15px_15px_rgba(0,0,0,0.6)]">
                    <!-- Truck Shadow -->
                    <ellipse cx="250" cy="200" rx="230" ry="12" fill="rgba(0,0,0,0.5)" class="blur-sm"/>

                    <!-- Exhaust Pipe & Smoke -->
                    <rect x="35" y="140" width="15" height="6" fill="#475569" />
                    <rect x="30" y="110" width="8" height="35" fill="#64748b" />

                    <!-- Cargo Container Box (Back) -->
                    <rect x="40" y="40" width="310" height="125" rx="8" fill="url(#truckCargoGrad)" stroke="#334155" stroke-width="3"/>
                    <line x1="140" y1="40" x2="140" y2="165" stroke="#1e293b" stroke-width="2"/>
                    <line x1="240" y1="40" x2="240" y2="165" stroke="#1e293b" stroke-width="2"/>
                    
                    <!-- Cargo Door at Back -->
                    <path d="M 40,40 L 40,165" stroke="#ea580c" stroke-width="6"/>

                    <!-- Express Delivery Logo on Cargo Container -->
                    <text x="180" y="105" fill="rgba(255,255,255,0.15)" font-size="28" font-weight="bold" font-family="sans-serif" text-anchor="middle">CARGO EXPRESS</text>

                    <!-- Cabin (Front) -->
                    <path d="M 350,75 L 420,75 L 460,115 L 465,165 L 350,165 Z" fill="url(#truckCabinGrad)" stroke="#1e293b" stroke-width="2"/>

                    <!-- Cabin Window -->
                    <path d="M 390,85 L 420,85 L 445,115 L 390,115 Z" fill="#38bdf8" fill-opacity="0.7" stroke="#0284c7" stroke-width="2"/>

                    <!-- Headlight & Bumper -->
                    <rect x="455" y="140" width="12" height="18" rx="3" fill="#fef08a" class="drop-shadow-[0_0_12px_rgba(250,204,21,0.9)]"/>
                    <rect x="445" y="155" width="25" height="12" rx="3" fill="#64748b"/>

                    <!-- Wheels -->
                    <g id="wheel1" transform="translate(90, 165)">
                        <circle cx="0" cy="0" r="26" fill="#0f172a" stroke="#334155" stroke-width="4"/>
                        <circle cx="0" cy="0" r="14" fill="#94a3b8" />
                        <line x1="-12" y1="0" x2="12" y2="0" stroke="#0f172a" stroke-width="3"/>
                        <line x1="0" y1="-12" x2="0" y2="12" stroke="#0f172a" stroke-width="3"/>
                    </g>
                    <g id="wheel2" transform="translate(180, 165)">
                        <circle cx="0" cy="0" r="26" fill="#0f172a" stroke="#334155" stroke-width="4"/>
                        <circle cx="0" cy="0" r="14" fill="#94a3b8" />
                        <line x1="-12" y1="0" x2="12" y2="0" stroke="#0f172a" stroke-width="3"/>
                        <line x1="0" y1="-12" x2="0" y2="12" stroke="#0f172a" stroke-width="3"/>
                    </g>
                    <g id="wheel3" transform="translate(410, 165)">
                        <circle cx="0" cy="0" r="26" fill="#0f172a" stroke="#334155" stroke-width="4"/>
                        <circle cx="0" cy="0" r="14" fill="#94a3b8" />
                        <line x1="-12" y1="0" x2="12" y2="0" stroke="#0f172a" stroke-width="3"/>
                        <line x1="0" y1="-12" x2="0" y2="12" stroke="#0f172a" stroke-width="3"/>
                    </g>

                    <defs>
                        <linearGradient id="truckCargoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#ea580c" />
                            <stop offset="100%" stop-color="#c2410c" />
                        </linearGradient>
                        <linearGradient id="truckCabinGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#1e293b" />
                            <stop offset="100%" stop-color="#0f172a" />
                        </linearGradient>
                    </defs>
                </svg>
            </div>

            <!-- Falling Luggage / Suitcase SVG -->
            <div id="fallingSuitcase" class="absolute z-30 w-32 h-28 opacity-0">
                <svg viewBox="0 0 200 160" class="w-full h-full drop-shadow-[0_20px_25px_rgba(0,0,0,0.6)]">
                    <path d="M 75,35 L 75,15 Q 75,10 80,10 L 120,10 Q 125,10 125,15 L 125,35" fill="none" stroke="#475569" stroke-width="7" stroke-linecap="round"/>
                    <rect x="20" y="35" width="160" height="115" rx="16" fill="url(#suitcaseGrad)" stroke="#fbbf24" stroke-width="3"/>
                    <rect x="20" y="35" width="30" height="30" rx="8" fill="#78350f"/>
                    <rect x="150" y="35" width="30" height="30" rx="8" fill="#78350f"/>
                    <rect x="20" y="120" width="30" height="30" rx="8" fill="#78350f"/>
                    <rect x="150" y="120" width="30" height="30" rx="8" fill="#78350f"/>
                    <rect x="60" y="35" width="14" height="115" fill="#451a03"/>
                    <rect x="126" y="35" width="14" height="115" fill="#451a03"/>
                    <circle id="latch1" cx="67" cy="92" r="6" fill="#f59e0b" class="transition-all duration-300"/>
                    <circle id="latch2" cx="133" cy="92" r="6" fill="#f59e0b" class="transition-all duration-300"/>
                    <rect x="85" y="85" width="30" height="14" rx="4" fill="#78350f"/>
                    <defs>
                        <linearGradient id="suitcaseGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#d97706" />
                            <stop offset="50%" stop-color="#b45309" />
                            <stop offset="100%" stop-color="#78350f" />
                        </linearGradient>
                    </defs>
                </svg>
            </div>
        </div>

        <!-- 3D FLIP CONTAINER FOR LOGIN & REGISTER FORMS -->
        <div id="authContainer" class="w-full opacity-0 scale-95 pointer-events-none transition-all duration-700 z-30">
            <div id="cardFlipper" class="flip-card-inner relative w-full">

                <!-- FRONT CARD: LOGIN FORM -->
                <div class="flip-card-front w-full bg-slate-900/85 backdrop-blur-xl border border-slate-700/60 rounded-3xl p-8 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.7)] relative overflow-hidden">
                    <div class="absolute -top-24 -left-24 w-48 h-48 bg-amber-500/20 rounded-full blur-3xl pointer-events-none"></div>
                    <div class="absolute -bottom-24 -right-24 w-48 h-48 bg-indigo-500/20 rounded-full blur-3xl pointer-events-none"></div>

                    <div class="text-center mb-8">
                        <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-tr from-amber-500 to-amber-300 text-slate-950 shadow-lg shadow-amber-500/30 mb-3">
                            <i class="fa-solid fa-suitcase-rolling text-2xl"></i>
                        </div>
                        <h2 class="text-2xl font-bold text-white tracking-wide">Selamat Datang!</h2>
                        <p class="text-xs text-slate-400 mt-1">Koper kargo telah terbuka. Silakan login ke akun Anda.</p>
                    </div>

                    <form id="loginForm" onsubmit="event.preventDefault(); handleAuthSuccess('Login');" class="space-y-5">
                        <div class="relative group">
                            <input type="email" required placeholder=" " id="loginEmail" class="floating-input w-full bg-slate-950/60 border border-slate-700/80 rounded-xl px-4 pt-5 pb-2 text-sm text-slate-100 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition-all peer">
                            <label for="loginEmail" class="floating-label absolute left-4 top-3.5 text-xs text-slate-400 pointer-events-none transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:top-3.5 peer-focus:top-1.5 peer-focus:text-[10px] peer-focus:text-amber-400">
                                <i class="fa-regular fa-envelope mr-1.5"></i>Alamat Email
                            </label>
                        </div>

                        <div class="relative group">
                            <input type="password" required placeholder=" " id="loginPassword" class="floating-input w-full bg-slate-950/60 border border-slate-700/80 rounded-xl px-4 pt-5 pb-2 text-sm text-slate-100 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition-all peer pr-10">
                            <label for="loginPassword" class="floating-label absolute left-4 top-3.5 text-xs text-slate-400 pointer-events-none transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:top-3.5 peer-focus:top-1.5 peer-focus:text-[10px] peer-focus:text-amber-400">
                                <i class="fa-solid fa-lock mr-1.5"></i>Kata Sandi
                            </label>
                            <button type="button" onclick="togglePasswordVisibility('loginPassword', this)" class="absolute right-3.5 top-3.5 text-slate-400 hover:text-slate-200 transition-colors cursor-pointer">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>

                        <div class="flex items-center justify-between text-xs text-slate-400 pt-1">
                            <label class="flex items-center gap-2 cursor-pointer hover:text-slate-200 transition-colors">
                                <input type="checkbox" class="rounded border-slate-700 bg-slate-900 text-amber-500 focus:ring-amber-500/40">
                                <span>Ingat Saya</span>
                            </label>
                            <a href="#" class="text-amber-400 hover:text-amber-300 transition-colors hover:underline">Lupa Sandi?</a>
                        </div>

                        <button type="submit" class="w-full py-3.5 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-semibold rounded-xl shadow-lg shadow-amber-500/25 transition-all duration-300 hover:shadow-amber-500/40 hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-2 cursor-pointer">
                            <span>Masuk Sekarang</span>
                            <i class="fa-solid fa-arrow-right text-sm"></i>
                        </button>
                    </form>

                    <div class="relative my-6 text-center">
                        <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-slate-800"></div></div>
                        <span class="relative px-3 bg-slate-900 text-[11px] text-slate-500 uppercase tracking-wider">Atau masuk dengan</span>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <button class="flex items-center justify-center gap-2 py-2.5 bg-slate-950/50 hover:bg-slate-800/80 border border-slate-800 rounded-xl text-xs text-slate-300 transition-all hover:border-slate-700 cursor-pointer">
                            <i class="fa-brands fa-google text-red-400"></i> Google
                        </button>
                        <button class="flex items-center justify-center gap-2 py-2.5 bg-slate-950/50 hover:bg-slate-800/80 border border-slate-800 rounded-xl text-xs text-slate-300 transition-all hover:border-slate-700 cursor-pointer">
                            <i class="fa-brands fa-github text-slate-100"></i> GitHub
                        </button>
                    </div>

                    <p class="text-center text-xs text-slate-400 mt-6">
                        Belum punya akun? 
                        <button id="goToRegister" class="text-amber-400 font-semibold hover:underline ml-1 cursor-pointer">Daftar Akun</button>
                    </p>
                </div>

                <!-- BACK CARD: REGISTER FORM -->
                <div class="flip-card-back absolute top-0 left-0 w-full bg-slate-900/85 backdrop-blur-xl border border-slate-700/60 rounded-3xl p-8 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.7)] overflow-hidden">
                    <div class="absolute -top-24 -right-24 w-48 h-48 bg-indigo-500/20 rounded-full blur-3xl pointer-events-none"></div>
                    <div class="absolute -bottom-24 -left-24 w-48 h-48 bg-amber-500/20 rounded-full blur-3xl pointer-events-none"></div>

                    <div class="text-center mb-6">
                        <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-tr from-indigo-500 to-cyan-400 text-slate-950 shadow-lg shadow-indigo-500/30 mb-3">
                            <i class="fa-solid fa-user-plus text-2xl"></i>
                        </div>
                        <h2 class="text-2xl font-bold text-white tracking-wide">Buat Akun Baru</h2>
                        <p class="text-xs text-slate-400 mt-1">Isi formulir untuk mulai mendaftar.</p>
                    </div>

                    <form id="registerForm" onsubmit="event.preventDefault(); handleAuthSuccess('Registrasi');" class="space-y-4">
                        <div class="relative group">
                            <input type="text" required placeholder=" " id="regName" class="floating-input w-full bg-slate-950/60 border border-slate-700/80 rounded-xl px-4 pt-5 pb-2 text-sm text-slate-100 focus:outline-none focus:border-indigo-400 focus:ring-1 focus:ring-indigo-400 transition-all peer">
                            <label for="regName" class="floating-label absolute left-4 top-3.5 text-xs text-slate-400 pointer-events-none transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:top-3.5 peer-focus:top-1.5 peer-focus:text-[10px] peer-focus:text-indigo-400">
                                <i class="fa-regular fa-user mr-1.5"></i>Nama Lengkap
                            </label>
                        </div>

                        <div class="relative group">
                            <input type="email" required placeholder=" " id="regEmail" class="floating-input w-full bg-slate-950/60 border border-slate-700/80 rounded-xl px-4 pt-5 pb-2 text-sm text-slate-100 focus:outline-none focus:border-indigo-400 focus:ring-1 focus:ring-indigo-400 transition-all peer">
                            <label for="regEmail" class="floating-label absolute left-4 top-3.5 text-xs text-slate-400 pointer-events-none transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:top-3.5 peer-focus:top-1.5 peer-focus:text-[10px] peer-focus:text-indigo-400">
                                <i class="fa-regular fa-envelope mr-1.5"></i>Alamat Email
                            </label>
                        </div>

                        <div class="relative group">
                            <input type="password" required placeholder=" " id="regPassword" class="floating-input w-full bg-slate-950/60 border border-slate-700/80 rounded-xl px-4 pt-5 pb-2 text-sm text-slate-100 focus:outline-none focus:border-indigo-400 focus:ring-1 focus:ring-indigo-400 transition-all peer pr-10">
                            <label for="regPassword" class="floating-label absolute left-4 top-3.5 text-xs text-slate-400 pointer-events-none transition-all peer-placeholder-shown:text-sm peer-placeholder-shown:top-3.5 peer-focus:top-1.5 peer-focus:text-[10px] peer-focus:text-indigo-400">
                                <i class="fa-solid fa-lock mr-1.5"></i>Kata Sandi
                            </label>
                            <button type="button" onclick="togglePasswordVisibility('regPassword', this)" class="absolute right-3.5 top-3.5 text-slate-400 hover:text-slate-200 transition-colors cursor-pointer">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>

                        <div class="flex items-center gap-2 text-xs text-slate-400 pt-1">
                            <input type="checkbox" required id="terms" class="rounded border-slate-700 bg-slate-900 text-indigo-500 focus:ring-indigo-500/40">
                            <label for="terms" class="cursor-pointer">Saya menyetujui <a href="#" class="text-indigo-400 hover:underline">Syarat & Ketentuan</a></label>
                        </div>

                        <button type="submit" class="w-full py-3.5 bg-gradient-to-r from-indigo-500 to-cyan-500 hover:from-indigo-400 hover:to-cyan-400 text-slate-950 font-semibold rounded-xl shadow-lg shadow-indigo-500/25 transition-all duration-300 hover:shadow-indigo-500/40 hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-2 mt-2 cursor-pointer">
                            <span>Daftar Sekarang</span>
                            <i class="fa-solid fa-user-check text-sm"></i>
                        </button>
                    </form>

                    <p class="text-center text-xs text-slate-400 mt-6">
                        Sudah punya akun? 
                        <button id="goToLogin" class="text-indigo-400 font-semibold hover:underline ml-1 cursor-pointer">Masuk Saja</button>
                    </p>
                </div>

            </div>
        </div>

    </div>

    <!-- Custom JavaScript Code -->
    <script>
        // Canvas Dust Particle Effect
        const canvas = document.getElementById('dustCanvas');
        const ctx = canvas.getContext('2d');
        let particles = [];

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        class DustParticle {
            constructor() {
                this.reset();
            }
            reset() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.size = Math.random() * 2 + 0.5;
                this.speedX = (Math.random() - 0.5) * 0.4;
                this.speedY = (Math.random() - 0.5) * 0.4;
                this.alpha = Math.random() * 0.5 + 0.1;
            }
            update() {
                this.x += this.speedX;
                this.y += this.speedY;
                if (this.x < 0 || this.x > canvas.width || this.y < 0 || this.y > canvas.height) {
                    this.reset();
                }
            }
            draw() {
                ctx.fillStyle = `rgba(226, 232, 240, ${this.alpha})`;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        for (let i = 0; i < 60; i++) {
            particles.push(new DustParticle());
        }

        function animateDust() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach(p => {
                p.update();
                p.draw();
            });
            requestAnimationFrame(animateDust);
        }
        animateDust();

        // GSAP Timeline Animation Sequence
        let mainTimeline = gsap.timeline();

        function startTruckSequence() {
            gsap.killTweensOf("#truckContainer, #wheel1, #wheel2, #wheel3, #fallingSuitcase, #authContainer");
            
            const truck = document.getElementById('truckContainer');
            const suitcase = document.getElementById('fallingSuitcase');
            const authContainer = document.getElementById('authContainer');
            const flipper = document.getElementById('cardFlipper');

            flipper.classList.remove('is-flipped');
            authContainer.style.opacity = '0';
            authContainer.style.pointerEvents = 'none';
            authContainer.style.transform = 'scale(0.95)';

            const screenWidth = window.innerWidth;
            const truckTargetX = screenWidth + 700;

            // Reset Initial Positions
            gsap.set(truck, { x: 0, opacity: 1 });
            gsap.set(suitcase, { opacity: 0, x: -180, y: -20, rotation: -20, scale: 1 });

            // Wheel continuous rotation
            gsap.to("#wheel1, #wheel2, #wheel3", {
                rotation: "+=2160",
                transformOrigin: "50% 50%",
                duration: 3.2,
                ease: "none"
            });

            mainTimeline = gsap.timeline();

            // 1. Truck drives across the screen at full speed
            mainTimeline.to(truck, {
                x: truckTargetX,
                duration: 2.8,
                ease: "power1.inOut"
            })
            // 2. WHILE the truck is driving past, luggage drops out from back
            .call(() => {
                gsap.set(suitcase, {
                    x: -120,
                    y: -10,
                    opacity: 1,
                    rotation: -25
                });
            }, null, 1.0)
            // 3. Luggage falls with momentum physics to the middle of the road
            .to(suitcase, {
                x: 0,
                y: 30,
                rotation: 60,
                duration: 0.45,
                ease: "power2.in"
            }, 1.0)
            // 4. Bounces on asphalt
            .to(suitcase, {
                x: 20,
                y: -10,
                rotation: 120,
                duration: 0.25,
                ease: "power1.out"
            }, 1.45)
            .to(suitcase, {
                x: 35,
                y: 20,
                rotation: 180,
                duration: 0.2,
                ease: "power1.in"
            }, 1.7)
            .to(suitcase, {
                x: 40,
                y: 15,
                rotation: 195,
                duration: 0.15,
                ease: "sine.out"
            }, 1.9)
            // 5. Suitcase settles in center and vibrates
            .to(suitcase, {
                x: "+=4",
                duration: 0.04,
                repeat: 8,
                yoyo: true,
                ease: "sine.inOut"
            }, 2.1)
            // 6. Latches glow blue & unlock pop
            .to("#latch1, #latch2", {
                fill: "#38bdf8",
                scale: 1.4,
                transformOrigin: "50% 50%",
                duration: 0.2
            }, 2.5)
            // Confetti burst from unlocked suitcase
            .call(() => {
                confetti({
                    particleCount: 60,
                    spread: 80,
                    origin: { y: 0.55 },
                    colors: ['#f59e0b', '#ea580c', '#38bdf8']
                });
            }, null, 2.7)
            // 7. Suitcase expands and morphs into Auth Card
            .to(suitcase, {
                scale: 1.8,
                opacity: 0,
                duration: 0.4,
                ease: "back.in(1.7)"
            }, 2.7)
            .to(authContainer, {
                opacity: 1,
                scale: 1,
                duration: 0.6,
                ease: "back.out(1.4)",
                onComplete: () => {
                    authContainer.style.pointerEvents = "auto";
                }
            }, 2.9);
        }

        window.addEventListener('load', () => {
            setTimeout(startTruckSequence, 300);
        });

        // 3D Card Flip Navigation
        const flipper = document.getElementById('cardFlipper');
        document.getElementById('goToRegister').addEventListener('click', () => {
            flipper.classList.add('is-flipped');
        });
        document.getElementById('goToLogin').addEventListener('click', () => {
            flipper.classList.remove('is-flipped');
        });

        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fa-regular fa-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'fa-regular fa-eye';
            }
        }

        function handleAuthSuccess(type) {
            confetti({
                particleCount: 80,
                spread: 100,
                origin: { y: 0.6 }
            });
            alert(`Berhasil! ${type} Anda telah diproses.`);
        }
    </script>
</body>
</html>
